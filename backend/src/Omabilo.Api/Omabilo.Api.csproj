<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A standalone ASP.NET Core API for Omabilo Personal that runs without IKON.
       The invoice, debt and demo-data logic is LINKED from the IKON app (app/Omabilo) so both
       use the same code; nothing here changes the IKON app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Omabilo.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\app\Omabilo\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\..\..\app\Omabilo\Invoices\InvoiceModel.cs" Link="Shared\InvoiceModel.cs" />
    <Compile Include="..\..\..\app\Omabilo\Invoices\InvoiceBook.cs" Link="Shared\InvoiceBook.cs" />
    <Compile Include="..\..\..\app\Omabilo\Invoices\InvoiceSources.cs" Link="Shared\InvoiceSources.cs" />
    <Compile Include="..\..\..\app\Omabilo\Invoices\SyntheticInvoices.cs" Link="Shared\SyntheticInvoices.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Omabilo.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
</Project>
