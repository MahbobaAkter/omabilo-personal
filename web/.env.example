# Copy to .env.local for local development (never commit .env files).
# VITE_ variables are built INTO the website and visible to anyone, so never put secrets here.

# Address of the Omabilo API. Locally: the backend's dotnet run address.
# In production (Vercel): the deployed API's https:// address. Never localhost.
VITE_API_BASE_URL=http://localhost:5080

# How the site signs in to the API.
#   demo = fictional demo users (works only with a backend running in Development)
#   none = no sign-in configured; the site explains that sign-in isn't set up yet
VITE_AUTH_MODE=demo
